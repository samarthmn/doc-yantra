{
  "name": "@samarthmn/doc-yantra",
  "description": "DocKosha pdf-core Zone 1 compiled to WebAssembly for in-app use (Node/Vercel + browser)",
  "version": "0.0.5",
  "files": [
    "pdf_core_wasm_bg.wasm",
    "pdf_core_wasm.js",
    "pdf_core_wasm.d.ts",
    "web"
  ],
  "main": "pdf_core_wasm.js",
  "types": "pdf_core_wasm.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samarthmn/doc-yantra.git"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./pdf_core_wasm.d.ts",
      "require": "./pdf_core_wasm.js",
      "default": "./pdf_core_wasm.js"
    },
    "./web": {
      "types": "./web/pdf_core_wasm.d.ts",
      "import": "./web/pdf_core_wasm.js",
      "default": "./web/pdf_core_wasm.js"
    },
    "./web/pdf_core_wasm_bg.wasm": "./web/pdf_core_wasm_bg.wasm",
    "./package.json": "./package.json"
  }
}
