{
  "name": "@samarthmn/doc-yantra-office",
  "description": "DocKosha office-core Office->PDF engine compiled to WebAssembly (Node/Vercel + browser)",
  "version": "0.0.10",
  "files": [
    "office_core_wasm_bg.wasm",
    "office_core_wasm.js",
    "office_core_wasm.d.ts",
    "web",
    "index.cjs",
    "index.d.ts",
    "font-provider.cjs",
    "font-provider.d.ts",
    "worker.js",
    "worker.d.ts",
    "worker-client.cjs",
    "worker-entry.cjs",
    "worker-ops.cjs",
    "build-fingerprint.json"
  ],
  "main": "index.cjs",
  "types": "index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samarthmn/doc-yantra.git"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.cjs",
      "default": "./index.cjs"
    },
    "./web": {
      "types": "./web/web-index.d.ts",
      "import": "./web/web-index.js",
      "default": "./web/web-index.js"
    },
    "./web/font-provider": {
      "types": "./web/font-provider.d.ts",
      "import": "./web/font-provider.js"
    },
    "./web/office_core_wasm_bg.wasm": "./web/office_core_wasm_bg.wasm",
    "./worker": {
      "types": "./worker.d.ts",
      "require": "./worker.js",
      "default": "./worker.js"
    },
    "./package.json": "./package.json"
  }
}
